---
import type { Locale } from '../i18n/utils';
import { useTranslations, localeUrls } from '../i18n/utils';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = [
  {
    key: 'p1',
    image: 'https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?auto=format&fit=crop&w=500',
    imageAlt: 'Humanitarian aid volunteers',
  },
  {
    key: 'p2',
    image: 'https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?auto=format&fit=crop&w=500',
    imageAlt: 'Cultural event music',
  },
  {
    key: 'p3',
    image: 'https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=500',
    imageAlt: 'Professional training classroom',
  },
] as const;
---

<section class="section" id="proyectos">
  <div class="container">
    <h2 class="section-title">{t('projects-title')}</h2>
    <p class="section-subtitle">{t('projects-subtitle')}</p>

    <div class="cards-grid">
      {projects.map(({ key, image, imageAlt }) => (
        <a href={`${localeUrls[lang]}mant/`} class="project-card">
          <div class="project-image">
            <img src={image} alt={imageAlt} width="500" height="200" loading="lazy" />
            <div class="project-badge">{t(`${key}-badge`)}</div>
          </div>
          <div class="project-content">
            <h3>{t(`${key}-title`)}</h3>
            <p>{t(`${key}-desc`)}</p>
            <span class="project-link">{t('project-learn-more')} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
