---
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="stats-bar" aria-label="Estadísticas">
  <div class="stat-item">
    <h3>+500</h3>
    <p>{t('stat-families')}</p>
  </div>
  <div class="stat-item">
    <h3>+12</h3>
    <p>{t('stat-projects')}</p>
  </div>
  <div class="stat-item">
    <h3>+1k</h3>
    <p>{t('stat-members')}</p>
  </div>
</div>
